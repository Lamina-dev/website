<div class="blog-post">
    <article class="post-content-wrapper">
        <div class="post-header">
            <h1 class="post-title"><%= page.title %></h1>
            <div class="post-meta">
                <span class="post-date"><i class="fas fa-calendar-alt"></i> <%= date(page.date, 'YYYY-MM-DD') %></span>
                <% if (page.categories && page.categories.length) { %>
                <span class="post-category">
                    <i class="fas fa-folder"></i>
                    <% page.categories.forEach(function(cat) { %>
                        <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
                    <% }) %>
                </span>
                <% } %>
                <% if (page.tags && page.tags.length) { %>
                <span class="post-tags">
                    <i class="fas fa-tags"></i>
                    <% page.tags.forEach(function(tag) { %>
                        <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
                    <% }) %>
                </span>
                <% } %>
            </div>
        </div>
        <div class="post-body">
            <%- page.content %>
        </div>
        <div class="post-footer-nav">
            <a href="/blog/" class="back-link"><i class="fas fa-arrow-left"></i> 返回博客</a>
        </div>
    </article>
</div>
