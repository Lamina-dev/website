<div class="portal-home">
    <section class="portal-hero">
        <div class="portal-shell portal-hero-grid">
            <div class="portal-hero-copy">
                <p class="portal-kicker">LAMINA SYSTEM</p>
                <h1>欢迎！</h1>
                <p class="portal-lead">Lamina 是一个面向数学、科学计算与系统编程的可编程数学环境。</p>
                <div class="portal-actions">
                    <a class="portal-button portal-button-primary" href="<%= url_for('/download/') %>"><i class="fa-solid fa-download" aria-hidden="true"></i> 下载 Lamina</a>
                    <a class="portal-button portal-button-quiet" href="https://docs.laminasys.org/" target="_blank" rel="noopener"><i class="fa-solid fa-book-open" aria-hidden="true"></i> 阅读文档</a>
                </div>
            </div>
            <div class="portal-mark">
                <img src="<%= url_for('/img/logo-icon.svg') %>" alt="Lamina Logo">
            </div>
        </div>
    </section>

    <section class="portal-section portal-intro">
        <div class="portal-shell portal-two-col">
            <article class="portal-intro-block">
                <div class="portal-intro-symbol"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></div>
                <div>
                    <h2>Lamina 是什么？</h2>
                    <p>Lamina 把符号数学、数值计算与通用编程放进同一套语言与工具链中，让表达式、矩阵、容器和程序逻辑能够自然地一起工作。</p>
                </div>
            </article>
            <article class="portal-intro-block">
                <div class="portal-intro-symbol"><i class="fa-solid fa-bolt" aria-hidden="true"></i></div>
                <div>
                    <h2>马上行动！</h2>
                    <p>下载 Lamina，阅读文档，尝试语言特性，或者直接加入社区、报告问题并参与项目开发。</p>
                </div>
            </article>
        </div>
    </section>

    <section class="portal-section portal-demo">
        <div class="portal-shell">
            <div class="portal-section-heading">
                <h2><i class="fa-solid fa-terminal" aria-hidden="true"></i> 快速体验</h2>
                <p>从表达式到矩阵推导，保持数学形式与程序结构的一致。</p>
            </div>
            <div class="portal-code-window">
                <div class="portal-code-title">script.lm</div>
                <pre><code>let c = 5
sym x
let res = c * x
sym x, y
let equation = x^2 + 1 + y*2
let val1 = equation =&gt; (x =&gt; 3, y =&gt; 4)

let squares = vec[x^2 for x in range(1, 10) if x % 2 == 0]
let abs_set = {abs(x) for x in vec[-1, 1, 2, -2]}
let M = mat[i * j for i in range(1,3); for j in range(1,3)]
let A = mat[1,2,3;4,5,6;7,8,9]
let v = vec[1,2,3]</code></pre>
            </div>
        </div>
    </section>

    <section class="portal-section portal-projects">
        <div class="portal-shell">
            <div class="portal-section-heading">
                <h2><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> 项目</h2>
                <p>Lamina 由语言核心、数值计算、计算机代数和高精度算术等多个组件共同构成。</p>
            </div>
            <div class="portal-project-grid">
                <article class="portal-project-card">
                    <div class="portal-project-icon" aria-hidden="true"><i class="fa-solid fa-code"></i></div>
                    <h3>Lamina</h3>
                    <p>语言与核心运行环境，提供统一的语法、类型和执行模型。</p>
                    <a href="https://github.com/Lamina-dev/Lamina" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i> 查看源码</a>
                </article>
                <article class="portal-project-card">
                    <div class="portal-project-icon" aria-hidden="true"><i class="fa-solid fa-calculator"></i></div>
                    <h3>LMMC</h3>
                    <p>Lamina 数值计算库，提供矩阵、稀疏线性代数、迭代求解、ODE、统计与 FFT 等能力。</p>
                    <a href="https://github.com/Lamina-dev/LMMC" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i> 查看源码</a>
                </article>
                <article class="portal-project-card">
                    <div class="portal-project-icon" aria-hidden="true"><i class="fa-solid fa-superscript"></i></div>
                    <h3>LMCAS</h3>
                    <p>Lamina 计算机代数系统，负责符号表达式、化简、求导、积分、方程与符号矩阵计算。</p>
                    <a href="https://github.com/Lamina-dev/LMCAS" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i> 查看源码</a>
                </article>
                <article class="portal-project-card">
                    <div class="portal-project-icon" aria-hidden="true"><i class="fa-solid fa-microchip"></i></div>
                    <h3>LAMMP</h3>
                    <p>Lamina 高精度计算库，为任意精度整数、数论运算与底层高性能算子提供基础能力。</p>
                    <a href="https://github.com/Lamina-dev/LAMMP" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i> 查看源码</a>
                </article>
            </div>
        </div>
    </section>

    <section class="portal-section portal-news">
        <div class="portal-shell">
            <div class="portal-section-heading portal-heading-row">
                <div>
                    <h2><i class="fa-solid fa-newspaper" aria-hidden="true"></i> 最新动态</h2>
                    <p>来自 Lamina 开发与社区的最新文章。</p>
                </div>
                <a class="portal-text-link" href="<%= url_for('/blog/') %>">全部文章 →</a>
            </div>
            <% const recentPosts = site.posts.sort('date', -1).limit(3); %>
            <% if (recentPosts.length) { %>
            <div class="portal-three-col portal-news-grid">
                <% recentPosts.forEach(function(post) { %>
                <article class="portal-news-item">
                    <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
                    <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
                    <% const summary = strip_html(post.excerpt || post.content || '').replace(/\s+/g, ' ').trim(); %>
                    <% if (summary) { %><p><%= summary.substring(0, 110) %><%= summary.length > 110 ? '…' : '' %></p><% } %>
                </article>
                <% }); %>
            </div>
            <% } else { %>
            <p class="portal-empty">博客文章正在准备中。</p>
            <% } %>
        </div>
    </section>

    <section class="portal-section portal-supporters">
        <div class="portal-shell">
            <div class="portal-section-heading">
                <h2><i class="fa-solid fa-handshake" aria-hidden="true"></i> 合作伙伴</h2>
            </div>
            <div class="portal-supporter-list">
                <a class="portal-supporter-card portal-supporter-brand" href="https://chuqiyun.com/aff/HNHKAJUX" target="_blank" rel="noopener">
                    <img src="https://chuqiyun.com/static/images/logo2.png" alt="初七云">
                    <span>为 Lamina 网络服务提供云服务支持。</span>
                </a>
                <div class="portal-supporter-card">
                    <i class="fa-solid fa-certificate" aria-hidden="true"></i>
                    <span>SignPath 为 Lamina 项目提供免费代码签名服务。</span>
                </div>
            </div>
        </div>
    </section>
</div>
